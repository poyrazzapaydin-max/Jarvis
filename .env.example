# Kopiere diese Datei zu ".env" für lokale Entwicklung.
# Auf Render.com: NICHT hochladen, stattdessen im Dashboard unter
# "Environment" eintragen (siehe Anleitung im Chat).

# Von https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Von MEXC: API-Verwaltung -> API erstellen -> NUR "Lesen" aktivieren!
MEXC_API_KEY=
MEXC_API_SECRET=

# Optional, Render setzt PORT automatisch selbst
PORT=5055
